# ==============================================================================
# WEBSTIX DIGITAL STUDIO — GMAIL SMTP & ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# GMAIL SMTP CONFIGURATION (Nodemailer)
# ------------------------------------------------------------------------------
# Place your real credentials in .env.local (do NOT commit .env.local to Git)
# SMTP_PASS must be a 16-character Google App Password (not your normal Gmail password).
# Generate from: Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello.webstix@gmail.com
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
CONTACT_TO=hello.webstix@gmail.com

# ------------------------------------------------------------------------------
# GITHUB INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Increases GitHub API rate limit from 60 to 5,000 req/hr.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# SITE METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://webstix.studio
